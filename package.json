{
  "name": "@entva/openterms",
  "description": "Generate legal texts in markdown format",
  "author": "Max Degterev <max@degterev.me>",
  "license": "MIT",
  "readmeFilename": "README.md",
  "repository": "entva/openterms",
  "bugs": "https://github.com/entva/openterms/issues",
  "version": "2.4.0",
  "type": "module",
  "keywords": [
    "legal",
    "terms",
    "privacy",
    "imprint",
    "cookies",
    "gdpr"
  ],
  "files": [
    "lib/"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.esm.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "oxlint": "oxlint --type-aware",
    "build": "rm -rf lib && rolldown --config rolldown.config.ts",
    "prepublishOnly": "npm run oxlint && npm run build && echo \"\\033[0;32mReady to publish\\033[0m\"",
    "test": "TZ='GMT' mocha \"./{,!(node_modules)/**}/*.test.js\""
  },
  "devDependencies": {
    "@entva/oxlint-config": "^2.51.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "^1.2.4",
    "rolldown-plugin-dts": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
